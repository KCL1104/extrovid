# Copy to .env and fill in. .env is gitignored.
# All three provider seams default to MOCK (offline, free, deterministic).

# --- LLM (planning agents + ReviewAgent) ---
# true = mock (FunctionModel, no network/key); false = real Qwen via DashScope.
USE_MOCK_LLM=true
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.7-plus          # all agents except the ScriptAgent
QWEN_SCRIPT_MODEL=qwen3.7-max    # flagship for the creative script step
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- AI review (dailies notes on every finished take) ---
AUTO_REVIEW=true
REVIEW_VISION=true   # attach the take's poster frame to the review (real-LLM mode only)

# --- Image generation (wan2.7-image-pro; gen + edit share the same unified model id) ---
USE_MOCK_IMAGE=true
QWEN_IMAGE_MODEL=wan2.7-image-pro
QWEN_IMAGE_EDIT_MODEL=wan2.7-image-pro

# --- Video generation (DashScope async submit -> poll; happyhorse default, or wan) ---
USE_MOCK_VIDEO=true
VIDEO_PROVIDER=happyhorse        # happyhorse (HappyHorse-1.1 t2v/i2v/r2v, 1.0 video-edit) | wan (Wan 2.7)
VIDEO_RESOLUTION=1080P           # HappyHorse-native; set 720P to halve cost
VIDEO_JOB_TIMEOUT_SEC=600

# --- Object storage (Railway / Tigris S3-compatible; unused in mock mode) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Database (PostgreSQL) ---
# App DB. Accepts postgresql://, postgres://, or postgresql+asyncpg:// (scheme normalized to asyncpg).
# On Railway, set DB_URL=${{Postgres.DATABASE_URL}} (private URL inside the project network).
# Locally, use the Railway public proxy URL (DATABASE_PUBLIC_URL).
DB_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME

# Optional: separate database for the test suite. If unset, tests fall back to in-memory SQLite.
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME_test

# --- Auth ---
# Admin master token (unlimited, sees all projects). Per-user accounts carry their own tokens.
API_TOKEN=
SESSION_SECRET=dev-insecure-change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Per-user daily caps for new accounts ---
DEFAULT_DAILY_VIDEO_CAP=3
DEFAULT_DAILY_IMAGE_CAP=20
