# extrovid production env for the ECS single-VM stack. Copy to `.env` and fill in.
# `.env` is gitignored — never commit real secrets. Lives next to docker-compose.yml on the box.

# ── Frontend build + serving ──
# Baked into the frontend bundle at build time. With no domain yet, use the ECS public IP.
NEXT_PUBLIC_API_BASE=http://YOUR_ECS_PUBLIC_IP/api
# Caddy site address: ":80" = plain HTTP. Set to a hostname (e.g. app.example.com) for auto-TLS.
SITE_ADDRESS=:80
ACME_EMAIL=

# ── App ──
# Any non-"local" value turns on the production secret guard (refuses dev defaults).
APP_ENV=production

# ── Database — Railway PostgreSQL (public TCP proxy) ──
# The ECS box is OUTSIDE Railway's private network, so use the Postgres service's
# DATABASE_PUBLIC_URL (host = *.proxy.rlwy.net), NOT the *.railway.internal one.
#   railway variables --service Postgres --kv | grep DATABASE_PUBLIC_URL
# The app auto-normalizes postgresql:// -> postgresql+asyncpg://. asyncpg ignores ?sslmode=;
# append ?ssl=require only if TLS is enforced. `alembic upgrade head` runs on boot to create schema.
DB_URL=postgresql://postgres:PASSWORD@xxxx.proxy.rlwy.net:PORT/railway
AUTO_CREATE_DB=false

# ── Object storage — Railway Bucket (S3-compatible, virtual-host, SigV4) ──
#   railway bucket credentials --bucket extrovid-media --json
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET=extrovid-media-5t8syh86qs
S3_ACCESS_KEY_ID=RAILWAY_BUCKET_ACCESS_KEY
S3_SECRET_ACCESS_KEY=RAILWAY_BUCKET_SECRET_KEY
# Railway uses SigV4 + virtual-host addressing (boto3 defaults) — leave S3_SIGNATURE_VERSION UNSET.
# S3_SIGNATURE_VERSION=

# ── DashScope / Qwen (unchanged — already international / Singapore) ──
DASHSCOPE_API_KEY=sk-xxxx
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ── Providers: go real in production ──
USE_MOCK_LLM=false
USE_MOCK_IMAGE=false
USE_MOCK_VIDEO=false   # ⚠ ONLY safe with a SINGLE backend instance (reconciler has no leader election)
USE_MOCK_TTS=true      # flip to false once qwen3-tts is verified against a live key

# ── Auth ──
API_TOKEN=CHANGE_ME_admin_master_token
SESSION_SECRET=CHANGE_ME_long_random_string

# ── Per-user daily caps ──
DEFAULT_DAILY_VIDEO_CAP=3
DEFAULT_DAILY_IMAGE_CAP=20
DEFAULT_DAILY_AUDIO_CAP=30
