# extrovid production env for the ECS single-VM stack. Copy to `.env` and fill in.
# `.env` is gitignored — never commit real secrets.

# ── Compose / infra (interpolated by docker-compose.yml) ──
# ACR pull endpoint INCLUDING namespace. Use the in-region -vpc host on the ECS box (free pull).
REGISTRY=registry-intl-vpc.ap-southeast-1.aliyuncs.com/extrovid
TAG=latest
# Domain whose A record points at this ECS instance's EIP. Caddy auto-provisions TLS for it.
DOMAIN=app.example.com
ACME_EMAIL=you@example.com

# ── App ──
# Any non-"local" value turns on the production secret guard: the backend refuses to boot if
# SESSION_SECRET is still the dev default or API_TOKEN is still a CHANGE_ME placeholder.
APP_ENV=production

# ── Database — ApsaraDB RDS for PostgreSQL ──
# Use the RDS *internal* (VPC) endpoint — NOT the public one — and whitelist the ECS security group.
# asyncpg ignores libpq's ?sslmode=. If RDS enforces TLS, append ?ssl=require (NOT ?sslmode=);
# if app+DB share the VPC with a security-group whitelist, SSL can be left off.
DB_URL=postgresql+asyncpg://USER:PASSWORD@pgm-xxxx.pg.rds.aliyuncs.com:5432/extrovid
AUTO_CREATE_DB=false

# ── Object storage — Alibaba OSS (S3-compatible) ──
S3_ENDPOINT=https://s3.oss-ap-southeast-1.aliyuncs.com
S3_REGION=ap-southeast-1
S3_BUCKET=your-extrovid-bucket
S3_ACCESS_KEY_ID=RAM_USER_AK
S3_SECRET_ACCESS_KEY=RAM_USER_SK
# OSS rejects boto3's SigV4-with-chunked-encoding on uploads — force SigV2.
S3_SIGNATURE_VERSION=s3

# ── DashScope / Qwen (unchanged — already international / Singapore) ──
DASHSCOPE_API_KEY=sk-xxxx
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ── Providers: go real in production ──
USE_MOCK_LLM=false
USE_MOCK_IMAGE=false
USE_MOCK_VIDEO=false   # ⚠ ONLY safe with a SINGLE backend instance (reconciler has no leader election)
USE_MOCK_TTS=true      # flip to false once qwen3-tts is verified against a live key

# ── Auth ──
API_TOKEN=CHANGE_ME_admin_master_token
SESSION_SECRET=CHANGE_ME_long_random_string
# Only needed if Google OAuth is enabled; must match the Google console redirect URIs.
BACKEND_BASE_URL=https://app.example.com
FRONTEND_BASE_URL=https://app.example.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Per-user daily caps ──
DEFAULT_DAILY_VIDEO_CAP=3
DEFAULT_DAILY_IMAGE_CAP=20
DEFAULT_DAILY_AUDIO_CAP=30
