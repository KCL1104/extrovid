# SITE_ADDRESS = ":80" → plain HTTP (no domain). A hostname → Caddy auto-provisions Let's Encrypt
# TLS (to add an ACME email then, put `tls you@example.com` inside the site block).
# One site serves both: /api (+ health/docs/oauth) → FastAPI, everything else → Next.js.
{$SITE_ADDRESS} {
	@backend path /api/* /health /docs /openapi.json
	handle @backend {
		reverse_proxy backend:8000 {
			# Stream Server-Sent Events immediately — never buffer text/event-stream.
			flush_interval -1
		}
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# ponytail: prod-only. Canonical host is www; redirect the bare apex so https://extrovid.xyz
# resolves (301 → www) instead of failing the TLS handshake. Caddy auto-provisions the apex
# cert for this block. In :80 no-domain mode it would noisily attempt ACME for the apex but
# won't affect the main site — acceptable since :80 mode is a vestigial bootstrap path.
extrovid.xyz {
	redir https://www.extrovid.xyz{uri} permanent
}
